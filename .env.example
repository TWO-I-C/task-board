# Copy to .env and replace the user with your macOS / PostgreSQL user.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=task_board
PGUSER=your_macos_username
# If your database requires a password, add PGPASSWORD only in .env.

# Local browser origins allowed for login/logout (comma separated).
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local HTTP only. A future HTTPS deployment must use true.
COOKIE_SECURE=false
